   "source": [
    "from PIL import Image \n",
    "import imagehash\n",
    "\n",
    "h1 = imagehash.phash(Image.open('img1.jpg'))\n",
    "h2 = imagehash.phash(Image.open('img2.jpg'))\n",
    "\n",
    "diff=h1-h2\n",
    "print(f\"diff={diff}\")\n",
    "\n",
    "if diff<10:\n",
    "  print(\"same image\")\n",
    "else:\n",
    "  print(\"Different\")\n"
   ]
